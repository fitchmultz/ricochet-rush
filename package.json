{
  "name": "ricochet-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/devServer.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "tsx src/server/previewServer.ts",
    "smoke": "tsx src/test/playabilitySmoke.ts",
    "capture:demo": "npm run build && tsx src/test/captureDemoClip.ts",
    "test": "vitest run",
    "ci": "npm run build && npm run test && npm run smoke"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.13",
    "three": "0.184.0",
    "vite": "8.0.13"
  },
  "overrides": {
    "tar": "7.5.15",
    "undici": "6.24.0"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/three": "0.184.1",
    "playwright": "1.60.0",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
