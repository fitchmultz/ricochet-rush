{
  "name": "ricochet-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/devServer.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "tsx src/server/previewServer.ts",
    "smoke": "tsx src/test/playabilitySmoke.ts",
    "ux": "npm run build && tsx src/test/uxAudit.ts",
    "ux:preview": "tsx src/test/uxAudit.ts",
    "capture:demo": "npm run build && tsx src/test/captureDemoClip.ts",
    "sdk:probe": "tsx src/test/sdkProbe.ts",
    "sdk:reliability": "tsx src/test/sdkReliability.ts",
    "test": "vitest run",
    "ci": "npm run deps:verify && npm run build && npm run test && npm run smoke && npm run ux:preview",
    "deps:verify": "tsx src/test/dependencyContracts.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.15",
    "three": "0.184.0",
    "vite": "8.0.14"
  },
  "overrides": {
    "@cursor/sdk": {
      "@connectrpc/connect-node": {
        "undici": "8.3.0"
      },
      "sqlite3": "npm:@appthreat/sqlite3@8.0.2"
    },
    "sqlite3": {
      "tar": "7.5.15",
      "node-gyp": {
        "tar": "7.5.15"
      }
    }
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/three": "0.184.1",
    "playwright": "1.60.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "@appthreat/sqlite3@8.0.2": true
  },
  "packageManager": "npm@11.16.0"
}
